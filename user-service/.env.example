PORT=3001
NODE_ENV=development

# Local database from docker-compose (use localhost:5433 when running outside Docker).
# For a hosted database such as Neon, paste its URL here with sslmode=require.
DATABASE_URL=postgresql://user:password@user-db:5432/userdb

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_URL=amqp://rabbitmq:5672

# SMTP, used for verification and password-reset emails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Your App <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com

# Base URLs of the frontend, used to build the links inside those emails
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://your-frontend.example.com
